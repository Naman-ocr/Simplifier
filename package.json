{
  "name": "simplifier-tally-automation",
  "version": "3.0.0",
  "description": "Enhanced invoice processing with Claude AI as primary extractor, Document AI and OpenAI as fallbacks, and Tally ERP integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node debug.js",
    "setup": "echo 'Please configure your .env file with Parseur and Document AI credentials'"
  },
  "keywords": [
    "invoice",
    "parseur",
    "document-ai",
    "strategy-1d",
    "tally",
    "automation",
    "pdf",
    "bulk-upload",
    "gst-processing",
    "cess-support",
    "round-off-handling",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google-cloud/documentai": "^9.2.0",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.2.5",
    "form-data": "^4.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^5.8.2",
    "pdf-to-img": "^4.5.0",
    "sharp": "^0.32.6",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "config": {
    "processing": {
      "primary_processor": "claude-ai",
      "fallback_processor": "document-ai",
      "secondary_fallback": "openai",
      "validation_strategy": "strategy-1d-progressive-fallback",
      "enhanced_features": [
        "cess-support",
        "round-off-handling",
        "force-mathematical-calculation",
        "gstin-validation",
        "claude-vision-extraction"
      ]
    }
  }
}
